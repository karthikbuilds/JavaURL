# =====================================================================
# JavaURL — deployment configuration reference
# Copy this to `.env` (rename to `.env`), fill values, and deploy.
# =====================================================================

# --- Server ---
# The backend always listens on 8081internally (Render injects its own port via SERVER_PORT).
SERVER_PORT=8081

# --- Database: choose ONE of the two below ---

# [A] Zero-setup DEMO — in-memory H2 (data resets on every restart; great for a demo)
SPRING_PROFILES_ACTIVE=dev

# [B] PERSISTENT — PostgreSQL (managed on Render/Railway/Fly) — comment out [A] first
# POSTGRES_URL=jdbc:postgresql://<host>:<port>/<db>
# POSTGRES_USER=javaurl
# POSTGRES_PASSWORD=your-strong-password

# --- Public base URL ---
# Set to your REAL live URL, or all shortened links return http://localhost:8081/...
# Render assigns like https://javaurl-backend.onrender.com
APP_BASE_URL=https://YOUR-BACKEND.onrender.com

# --- Frontend (index.html) ---
# Point the static UI at the same backend URL by uncommenting the block in frontend/index.html:
#   window.JAVAURL_CONFIG_OVERRIDE = {
#     apiBase: 'https://YOUR-BACKEND.onrender.com',
#     wsBase:  'wss://YOUR-BACKEND.onrender.com'
#   };

# --- Optional tuning (defaults are fine) ---
# APP_CODE_LENGTH=7
# APP_REDIRECT_STATUS=302
# APP_RATELIMIT_ENABLED=true
# APP_RATELIMIT_CAPACITY=100
# APP_RATELIMIT_REFILL_PER_SECOND=50